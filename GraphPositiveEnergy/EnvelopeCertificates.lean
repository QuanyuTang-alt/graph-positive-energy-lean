  have hv : 0 ≤ 1-u := by dsimp [u]; linarith
  have heq : t = 2+((2/5 : ℝ))*u := by dsimp [u]; ring
  rw [heq, envelope_identity_0]
  apply Finset.sum_nonneg
  intro i _
  have hc : 0 ≤ envelopeCoeffs0 i := by fin_cases i <;> norm_num [envelopeCoeffs0]
  exact mul_nonneg (mul_nonneg hc (pow_nonneg hu _)) (pow_nonneg hv _)

