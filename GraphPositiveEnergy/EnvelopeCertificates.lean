def envelopePoly0 (t : ℝ) : ℝ := ((-70/27 : ℝ)) + ((49/8 : ℝ))*t^2 + ((-7/2 : ℝ))*t^3 + ((1/2 : ℝ))*t^4
def envelopeCoeffs0 : Fin 5 → ℝ := ![(103/54 : ℝ), (949/135 : ℝ), (4133/450 : ℝ), (16678/3375 : ℝ), (15056/16875 : ℝ)]
theorem envelope_identity_0 (u : ℝ) :
    envelopePoly0 (2+((2/5 : ℝ))*u) =
      ∑ i : Fin 5, envelopeCoeffs0 i*u^i.val*(1-u)^(4-i.val) := by
  norm_num [envelopePoly0, envelopeCoeffs0, Fin.sum_univ_succ]
