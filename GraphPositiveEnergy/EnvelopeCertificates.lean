theorem envelope_nonneg_0 {t : ℝ} (ha : 2 ≤ t) (hb : t ≤ (12/5 : ℝ)) :
    0 ≤ envelopePoly0 t := by
  let u : ℝ := (t-2)/((2/5 : ℝ))
